{
  "name": "minipos",
  "version": "0.1.0",
  "description": "Simple offline Windows POS by SparkPair",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.sparkpair.minipos",
    "productName": "MiniPOS",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "MiniPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MiniPOS-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Spark-Pair",
      "repo": "MiniPOS",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "MiniPOS-Portable-${version}.${ext}"
    }
  }
}
